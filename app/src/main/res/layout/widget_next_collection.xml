<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:id="@+id/widget_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/widget_bin_icon"
        android:text="Next Collection"
        android:textSize="14sp"
        android:textColor="@color/widget_text_secondary"
        android:textStyle="bold" />

    <!-- Bin Icon in upper right -->
    <ImageView
        android:id="@+id/widget_bin_icon"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:adjustViewBounds="true"
        android:scaleType="fitEnd"
        android:visibility="gone" />

    <!-- Date -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="4dp"
        android:text="Loading..."
        android:textSize="18sp"
        android:textColor="@color/widget_text"
        android:textStyle="bold" />

    <!-- Bin Names -->
    <TextView
        android:id="@+id/widget_bin_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_date"
        android:layout_above="@+id/widget_btn_put_out_container"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="16sp"
        android:textColor="@color/widget_text" />

    <!-- Put Out Button Container at bottom -->
    <FrameLayout
        android:id="@+id/widget_btn_put_out_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_btn_outlined">

        <TextView
            android:id="@+id/widget_btn_put_out"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:gravity="center"
            android:text="Put Out"
            android:textColor="#046A38"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

</RelativeLayout>